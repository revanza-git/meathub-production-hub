{
  "version": 1,
  "sdk_version": "0.26.3",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://xnqolyggsxxdwjpvzvct.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "meatlink",
      "version": "0.1.0",
      "title": "Meatlink.id"
    },
    "tools": [
      {
        "name": "list_available_stock",
        "title": "List available stock",
        "description": "List aggregated meat stock available on Meatlink (product name, category, total kg). Vendor identities are not exposed.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "search": {
              "description": "Optional text filter on the product name.",
              "type": "string"
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "list_my_orders",
        "title": "List my orders",
        "description": "List the signed-in user's Meatlink orders with status, quantity, payment term and notes. Newest first.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "status": {
              "description": "Optional status filter.",
              "type": "string",
              "enum": [
                "PENDING",
                "CONFIRMED",
                "ON_HOLD",
                "REJECTED",
                "DELIVERED"
              ]
            },
            "limit": {
              "description": "Maximum rows to return; defaults to 20.",
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "create_order",
        "title": "Create order",
        "description": "Create a new Meatlink order for the signed-in user. Quantity is in kilograms; payment term is CBD, TOP7, TOP14 or TOP30.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "buyer_name": {
              "type": "string",
              "minLength": 1,
              "description": "Company or contact name placing the order."
            },
            "product_text": {
              "type": "string",
              "minLength": 1,
              "description": "Free-text product description."
            },
            "qty_kg": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "Quantity in kilograms."
            },
            "payment_term": {
              "type": "string",
              "enum": [
                "CBD",
                "TOP7",
                "TOP14",
                "TOP30"
              ],
              "description": "Payment term."
            },
            "delivery_location": {
              "description": "Delivery city or address.",
              "type": "string"
            },
            "needed_by": {
              "description": "Required date, ISO format YYYY-MM-DD.",
              "type": "string"
            },
            "buyer_notes": {
              "description": "Extra notes for the Meatlink team.",
              "type": "string"
            }
          },
          "required": [
            "buyer_name",
            "product_text",
            "qty_kg",
            "payment_term"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "get_market_snapshot",
        "title": "Get market snapshot",
        "description": "Aggregated Indonesian beef market data from Meatlink: house inventory by origin (kg, average base and public price, low-stock count), vendor stock by category, quote-request demand by category and region, order activity by status and payment term, plus tracked market metrics. Aggregate only — no company names, contacts or vendor identities.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "days": {
              "description": "Look-back window in days for demand and order activity. Defaults to 90.",
              "type": "integer",
              "minimum": 1,
              "maximum": 730
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "list_market_insights",
        "title": "List market insights",
        "description": "List existing Meatlink market insight notes (sourcing notes) so you can avoid duplicates and follow up on earlier periods. Newest first.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "status": {
              "description": "Optional status filter.",
              "type": "string",
              "enum": [
                "draft",
                "published",
                "archived"
              ]
            },
            "region": {
              "description": "Optional region filter, e.g. Jakarta.",
              "type": "string"
            },
            "limit": {
              "description": "Maximum rows; defaults to 20.",
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "create_market_insight",
        "title": "Create market insight",
        "description": "Write a current, actionable Indonesian beef sourcing note in both Bahasa Indonesia and English. Always saved as a draft. Requires recent official public Indonesian market observations plus cited structural data; never use Meatlink internal marketplace data.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "title_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160,
              "description": "Short Bahasa Indonesia headline for the note."
            },
            "body_id": {
              "type": "string",
              "minLength": 1,
              "description": "Bahasa Indonesia analysis, 2-5 sentences, concrete and practical."
            },
            "title_en": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160,
              "description": "Faithful English translation of title_id."
            },
            "body_en": {
              "type": "string",
              "minLength": 1,
              "description": "Faithful English translation of body_id, preserving all figures and caveats."
            },
            "category": {
              "description": "Note category. Defaults to demand.",
              "type": "string",
              "enum": [
                "demand",
                "pricing",
                "supply",
                "logistics",
                "regulation"
              ]
            },
            "region": {
              "description": "Region the note applies to, e.g. Jakarta, Bali, Nasional.",
              "type": "string"
            },
            "period_label": {
              "description": "Human period label, e.g. 'Agustus 2026' or 'Q3 2026'.",
              "type": "string"
            },
            "confidence": {
              "description": "How strongly the underlying data supports the note.",
              "type": "string",
              "enum": [
                "low",
                "medium",
                "high"
              ]
            },
            "audience": {
              "type": "string",
              "enum": [
                "buyer",
                "supplier",
                "both"
              ],
              "description": "Who can act on the recommendation."
            },
            "time_horizon_days": {
              "type": "integer",
              "minimum": 1,
              "maximum": 180,
              "description": "How long the recommendation is intended to remain useful."
            },
            "observation_ids": {
              "minItems": 1,
              "maxItems": 20,
              "type": "array",
              "items": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              "description": "Recent public_market_observations that establish present-day relevance."
            },
            "data_refs": {
              "description": "JSON object of the numbers the note is based on.",
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {}
            }
          },
          "required": [
            "title_id",
            "body_id",
            "title_en",
            "body_en",
            "audience",
            "time_horizon_days",
            "observation_ids"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "update_market_insight",
        "title": "Update market insight draft",
        "description": "Revise an existing bilingual Meatlink sourcing note that is still a draft. Publishing is done by a Meatlink admin, not by this tool.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "description": "Insight id to update."
            },
            "title_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "body_id": {
              "type": "string",
              "minLength": 1
            },
            "title_en": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "body_en": {
              "type": "string",
              "minLength": 1
            },
            "category": {
              "type": "string",
              "enum": [
                "demand",
                "pricing",
                "supply",
                "logistics",
                "regulation"
              ]
            },
            "region": {
              "type": "string"
            },
            "period_label": {
              "type": "string"
            },
            "confidence": {
              "type": "string",
              "enum": [
                "low",
                "medium",
                "high"
              ]
            },
            "data_refs": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {}
            }
          },
          "required": [
            "id"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "get_public_beef_market_data",
        "title": "Get public beef market data",
        "description": "Read public beef-market statistics from FAOSTAT and USDA FAS. Returns FAOSTAT cattle-meat production history and USDA Beef & Veal production, import, export and consumption forecasts. Contains public external data only; it never reads Meatlink inventory, buyers, vendors, orders or RFQs.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": true
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "countries": {
              "description": "Countries to compare. Defaults to Indonesia and major Meatlink-relevant beef origins.",
              "minItems": 1,
              "maxItems": 6,
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "Indonesia",
                  "Australia",
                  "United States",
                  "Canada",
                  "Japan",
                  "New Zealand"
                ]
              }
            },
            "market_year": {
              "description": "USDA market year. Defaults to the previous calendar year.",
              "type": "integer",
              "minimum": 1961,
              "maximum": 2100
            },
            "history_years": {
              "description": "Number of calendar years requested from FAOSTAT. Defaults to 8.",
              "type": "integer",
              "minimum": 1,
              "maximum": 15
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "record_public_market_observation",
        "title": "Record public Indonesian market observation",
        "description": "Record a dated candidate observation from an approved Indonesian government source. Admin only. This stores external public evidence, never Meatlink marketplace data.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": true
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "source_name": {
              "type": "string",
              "enum": [
                "pihps_bi",
                "sp2kp_kemendag",
                "bapanas",
                "kementan",
                "bps",
                "bank_indonesia"
              ]
            },
            "source_url": {
              "type": "string",
              "format": "uri"
            },
            "signal_type": {
              "type": "string",
              "enum": [
                "price",
                "industry",
                "policy",
                "seasonal",
                "macro"
              ]
            },
            "commodity": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "market_level": {
              "type": "string",
              "enum": [
                "producer",
                "rph_wholesale",
                "retail",
                "import",
                "industry",
                "policy",
                "macro"
              ]
            },
            "region": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "observed_on": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "price_idr_per_kg": {
              "type": "number",
              "minimum": 0
            },
            "value": {
              "type": "number"
            },
            "unit": {
              "type": "string",
              "maxLength": 80
            },
            "summary": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            }
          },
          "required": [
            "source_name",
            "source_url",
            "signal_type",
            "market_level",
            "observed_on",
            "summary"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "list_public_market_observations",
        "title": "List public Indonesian market observations",
        "description": "List recent price, policy, industry, seasonal, and macro observations from approved Indonesian government sources. Contains no Meatlink marketplace data.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "max_age_days": {
              "type": "integer",
              "minimum": 1,
              "maximum": 365
            },
            "signal_type": {
              "type": "string",
              "enum": [
                "price",
                "industry",
                "policy",
                "seasonal",
                "macro"
              ]
            },
            "region": {
              "type": "string"
            },
            "verification_status": {
              "type": "string",
              "enum": [
                "candidate",
                "verified"
              ]
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "review_public_market_observation",
        "title": "Review public market observation",
        "description": "Verify or reject a candidate external market observation after checking its official source. Admin only.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "verification_status": {
              "type": "string",
              "enum": [
                "verified",
                "rejected"
              ]
            },
            "review_notes": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            }
          },
          "required": [
            "id",
            "verification_status",
            "review_notes"
          ]
        },
        "outputSchema": null
      }
    ]
  }
}
